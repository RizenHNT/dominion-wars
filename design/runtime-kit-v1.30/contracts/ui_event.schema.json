{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dominion Wars UI Event",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "turn",
    "phase"
  ],
  "properties": {
    "eventId": {
      "type": "string"
    },
    "parentEventId": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "enum": [
        "PHASE_CHANGED",
        "TURN_CHANGED",
        "CARD_PLAYED",
        "AMBUSH_SET",
        "AMBUSH_TRIGGERED",
        "ATTACK_DECLARED",
        "TARGET_REJECTED",
        "DAMAGE_APPLIED",
        "HEAL_APPLIED",
        "PUNISH_ISSUED",
        "PUNISH_DRAW",
        "PUNISH_TRIGGERED",
        "CHAIN_LINK",
        "CHAIN_RESOLVED",
        "CASTLE_DAMAGED",
        "CASTLE_BROKEN",
        "LEADER_MANIFESTED",
        "LEADER_DISABLED",
        "VICTORY_PROGRESS",
        "DECK_CYCLED",
        "CARD_DISCARDED",
        "GAME_OVER"
      ]
    },
    "turn": {
      "type": "integer"
    },
    "phase": {
      "type": "string"
    },
    "sourceId": {
      "type": [
        "string",
        "null"
      ]
    },
    "targetIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "amount": {
      "type": [
        "integer",
        "number",
        "null"
      ]
    },
    "reasonKey": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "type": "object"
    }
  }
}