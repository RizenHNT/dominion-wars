<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build the pinned current-source driver first with dynamic/build-probe.ps1.
       Both CLIs consume the same Engine/Data/Adapters/PlCsim assembly set. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>WoodPoolProbe</AssemblyName>
    <RootNamespace>WoodPoolProbe</RootNamespace>
    <AssemblySearchPaths>{HintPathFromItem};{CandidateAssemblyFiles};{TargetFrameworkDirectory};{RawFileName}</AssemblySearchPaths>
    <DriverDirectory>$(MSBuildThisFileDirectory)..\dynamic\probe\</DriverDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="DominionWars.Engine"><HintPath>$(DriverDirectory)DominionWars.Engine.dll</HintPath></Reference>
    <Reference Include="DominionWars.Data"><HintPath>$(DriverDirectory)DominionWars.Data.dll</HintPath></Reference>
    <Reference Include="DominionWars.Adapters"><HintPath>$(DriverDirectory)DominionWars.Adapters.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(DriverDirectory)Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="PlCsim"><HintPath>$(DriverDirectory)PlCsim.dll</HintPath></Reference>
    <None Include="$(DriverDirectory)PINNED_REVISION.json" Link="PINNED_REVISION.json" CopyToOutputDirectory="Always" />
    <None Include="$(DriverDirectory)SOURCE_REVISION.json" Link="SOURCE_REVISION.json" CopyToOutputDirectory="Always" />
  </ItemGroup>
  <Target Name="RequireSharedDriver" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(DriverDirectory)PlCsim.dll')" Text="Run build-output/dynamic/build-probe.ps1 first to compile the shared driver." />
  </Target>
</Project>
